// Hospital CRM — Patient Management data model
// Phase 1: Patient CRM, Appointment System, Timeline, Search, CRM, Dashboard

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Staff identity (auth is external / not rebuilt here — this table is the
// minimal identity surface other modules reference: who booked, who wrote a
// note, who is the doctor on an appointment, etc.)
// ─────────────────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  DOCTOR
  NURSE
  FRONT_DESK
  BILLING
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?
  role              StaffRole
  specialization    String?
  department        String?
  consultationFee   Decimal? @db.Decimal(10, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  registeredPatients   Patient[]            @relation("PatientRegisteredBy")
  doctorAvailabilities DoctorAvailability[]
  doctorLeaves         DoctorLeave[]
  appointmentsAsDoctor Appointment[]        @relation("AppointmentDoctor")
  appointmentsCreated  Appointment[]        @relation("AppointmentCreatedBy")
  admissionsAsDoctor   Admission[]          @relation("AdmissionDoctor")
  prescriptionsWritten Prescription[]       @relation("PrescriptionDoctor")
  documentsUploaded    Document[]           @relation("DocumentUploadedBy")
  messagesSent         Message[]            @relation("MessageSentBy")
  notesWritten         PatientNote[]        @relation("NoteAuthor")
  followUpsAssigned    FollowUp[]           @relation("FollowUpAssignedTo")
  waitingListEntries   WaitingListEntry[]   @relation("WaitingListDoctor")

  encountersAsDoctor       Encounter[]              @relation("EncounterDoctor")
  clinicalNotesWritten     ClinicalNote[]           @relation("ClinicalNoteDoctor")
  doctorTemplates          DoctorTemplate[]         @relation("DoctorTemplateOwner")
  digitalSignature         DigitalSignature?        @relation("DoctorSignature")
  clinicalReportsOrdered   ClinicalReport[]         @relation("ClinicalReportDoctor")
  dischargeSummariesWritten DischargeSummaryRecord[] @relation("DischargeSummaryDoctor")
  referralsWritten         ReferralNote[]           @relation("ReferralFromDoctor")
  certificatesIssued       Certificate[]            @relation("CertificateDoctor")

  paymentsReceived    Payment[]        @relation("PaymentReceivedBy")
  refundsProcessed    Refund[]         @relation("RefundProcessedBy")
  advancesReceived    PatientAdvance[] @relation("AdvanceReceivedBy")
  cashSessionsOpened  CashSession[]    @relation("CashSessionOpenedBy")
  cashSessionsClosed  CashSession[]    @relation("CashSessionClosedBy")
  expensesRecorded    Expense[]        @relation("ExpenseRecordedBy")

  icuRoundsRecorded        IcuRound[]         @relation("IcuRoundRecordedBy")
  surgeriesAsSurgeon       Surgery[]          @relation("SurgeryLeadSurgeon")
  emergencyCasesAttended   EmergencyCase[]    @relation("EmergencyAttending")
  labOrdersAsDoctor        LabOrder[]         @relation("LabOrderDoctor")
  samplesCollected         Sample[]           @relation("SampleCollectedBy")
  radiologyOrdersAsDoctor  RadiologyOrder[]   @relation("RadiologyOrderDoctor")
  purchaseOrdersCreated    PurchaseOrder[]    @relation("PurchaseOrderCreatedBy")
  pharmacyDispensesGiven   PharmacyDispense[] @relation("PharmacyDispensedBy")
  ticketsReported          FacilityTicket[]   @relation("TicketReportedBy")
  ticketsAssigned          FacilityTicket[]   @relation("TicketAssignedTo")

  employeeProfile           Employee?
  departmentsHeaded         Department[]          @relation("DepartmentHead")
  leavesApproved            LeaveRequest[]        @relation("LeaveApprovedBy")
  reviewsGiven              PerformanceReview[]    @relation("ReviewReviewer")
  jobOpeningsPosted         JobOpening[]           @relation("JobOpeningPostedBy")
  announcementsPosted       Announcement[]         @relation("AnnouncementPostedBy")
  chatMessagesSent          ChatMessage[]          @relation("ChatMessageSender")
  chatChannelsMemberOf      ChatChannelMember[]    @relation("ChatChannelMemberUser")
  tasksAssignedToMe         Task[]                 @relation("TaskAssignedTo")
  tasksAssignedByMe         Task[]                 @relation("TaskAssignedBy")
  meetingsOrganized         Meeting[]              @relation("MeetingOrganizer")
  meetingsAttending         MeetingAttendee[]      @relation("MeetingAttendeeUser")
  exitRequestsApproved      ExitRequest[]          @relation("ExitApprovedBy")
  onboardingTasksAssigned   OnboardingTask[]        @relation("OnboardingAssignedTo")

  @@index([role])
}

// Atomic named sequence counters (used for UHID / bill number generation)
model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────────────────
// Patient — the single digital identity
// ─────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

model Patient {
  id               String         @id @default(cuid())
  uhid             String         @unique
  firstName        String
  lastName         String?
  dob              DateTime?
  gender           Gender?
  bloodGroup       BloodGroup?    @default(UNKNOWN)
  maritalStatus    MaritalStatus? @default(UNKNOWN)
  occupation       String?
  phone            String
  alternatePhone   String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?        @default("India")
  photoUrl         String?
  status           PatientStatus  @default(ACTIVE)
  notesSummary     String?

  registeredById   String?
  registeredBy     User?          @relation("PatientRegisteredBy", fields: [registeredById], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tags                    PatientTag[]
  familyMembers           FamilyMember[]
  insurances              Insurance[]
  emergencyContacts       EmergencyContact[]
  medicalAlerts           MedicalAlert[]
  allergies               Allergy[]
  chronicDiseases         ChronicDisease[]
  vaccinations            Vaccination[]
  documents               Document[]
  communicationPreference CommunicationPreference?
  appointments            Appointment[]
  waitingListEntries      WaitingListEntry[]
  admissions              Admission[]
  prescriptions           Prescription[]
  bills                   Bill[]
  payments                Payment[]
  messages                Message[]
  notes                   PatientNote[]
  followUps               FollowUp[]
  feedback                Feedback[]
  relatedToFamilyOf       FamilyMember[]           @relation("RelatedPatient")

  encounters              Encounter[]
  medicalHistory          MedicalHistory[]
  familyHistory           FamilyHistoryEntry[]
  surgicalHistory         SurgicalHistory[]
  currentMedications      CurrentMedication[]
  clinicalReports         ClinicalReport[]
  dischargeSummaryRecords DischargeSummaryRecord[]
  referralNotes           ReferralNote[]
  certificates            Certificate[]

  corporateLinks   CorporatePatient[]
  insuranceClaims  InsuranceClaim[]
  refunds          Refund[]
  advances         PatientAdvance[]

  surgeries          Surgery[]
  emergencyCases     EmergencyCase[]
  ambulanceTrips     AmbulanceTrip[]
  labOrders          LabOrder[]
  radiologyOrders    RadiologyOrder[]
  pharmacyDispenses  PharmacyDispense[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([firstName, lastName])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String       @default("#6366f1")
  patients PatientTag[]
}

model PatientTag {
  patientId String
  tagId     String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([patientId, tagId])
}

model FamilyMember {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relatedPatientId String?
  relatedPatient  Patient? @relation("RelatedPatient", fields: [relatedPatientId], references: [id])
  name            String
  relation        String
  phone           String?
  dob             DateTime?
  isEmergencyContact Boolean @default(false)
  createdAt       DateTime @default(now())

  @@index([patientId])
}

model Insurance {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider        String
  policyNumber    String
  planName        String?
  tpaName         String?
  coverageAmount  Decimal?  @db.Decimal(12, 2)
  validFrom       DateTime?
  validTo         DateTime?
  isPrimary       Boolean   @default(true)
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())

  bills  Bill[]
  claims InsuranceClaim[]

  @@index([patientId])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  phone     String
  altPhone  String?
  address   String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  ALLERGY
  CONDITION
  DEVICE
  BEHAVIORAL
  OTHER
}

model MedicalAlert {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  description String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([patientId])
}

model Allergy {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String?
  severity  AlertSeverity @default(MEDIUM)
  notedOn   DateTime      @default(now())

  @@index([patientId])
}

enum ChronicDiseaseStatus {
  ACTIVE
  MANAGED
  RESOLVED
}

model ChronicDisease {
  id           String                @id @default(cuid())
  patientId    String
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  diagnosedOn  DateTime?
  status       ChronicDiseaseStatus  @default(ACTIVE)
  notes        String?
  createdAt    DateTime              @default(now())

  @@index([patientId])
}

model Vaccination {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccineName     String
  doseNumber      Int       @default(1)
  dateGiven       DateTime
  nextDueDate     DateTime?
  batchNumber     String?
  administeredBy  String?
  createdAt       DateTime  @default(now())

  @@index([patientId])
}

enum DocumentCategory {
  ID_PROOF
  INSURANCE
  LAB_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  CONSENT_FORM
  IMAGING
  OTHER
}

model Document {
  id             String           @id @default(cuid())
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title          String
  category       DocumentCategory @default(OTHER)
  fileUrl        String
  fileType       String?
  uploadedById   String?
  uploadedBy     User?            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt     DateTime         @default(now())

  @@index([patientId])
  @@index([category])
}

enum CommChannel {
  SMS
  EMAIL
  WHATSAPP
  CALL
  SYSTEM
}

model CommunicationPreference {
  id                String   @id @default(cuid())
  patientId         String   @unique
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  preferredChannel  CommChannel @default(SMS)
  allowSms          Boolean  @default(true)
  allowEmail        Boolean  @default(true)
  allowWhatsapp     Boolean  @default(true)
  allowCall         Boolean  @default(true)
  allowMarketing    Boolean  @default(false)
  preferredLanguage String   @default("English")
  updatedAt         DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Appointment system
// ─────────────────────────────────────────────────────────────────────────

model DoctorAvailability {
  id                 String   @id @default(cuid())
  doctorId           String
  doctor             User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek          Int // 0 = Sunday .. 6 = Saturday
  startTime          String // "09:00"
  endTime            String // "13:00"
  slotDurationMinutes Int     @default(15)
  location           String?
  isActive           Boolean  @default(true)

  @@index([doctorId])
}

model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([doctorId, date])
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  WALK_IN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Appointment {
  id               String            @id @default(cuid())
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           User              @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  scheduledAt      DateTime
  durationMinutes  Int               @default(15)
  type             AppointmentType   @default(IN_PERSON)
  status           AppointmentStatus @default(SCHEDULED)
  reason           String?
  notes            String?
  tokenNumber      Int?
  queuePosition    Int?
  videoLink        String?
  cancelReason     String?
  cancelledAt      DateTime?
  checkedInAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?

  rescheduledFromId String?
  rescheduledFrom   Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment[] @relation("AppointmentReschedule")

  createdById String?
  createdBy   User?    @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  bills         Bill[]
  prescriptions Prescription[]
  feedback      Feedback[]
  followUps     FollowUp[]
  encounters    Encounter[]

  @@index([patientId])
  @@index([doctorId, scheduledAt])
  @@index([status])
}

enum WaitingListStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
}

model WaitingListEntry {
  id            String            @id @default(cuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?             @relation("WaitingListDoctor", fields: [doctorId], references: [id])
  requestedDate DateTime?
  reason        String?
  priority      Int               @default(0)
  status        WaitingListStatus @default(WAITING)
  createdAt     DateTime          @default(now())

  @@index([patientId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Admissions / Prescriptions / Billing / Payments
// ─────────────────────────────────────────────────────────────────────────

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

model Admission {
  id               String          @id @default(cuid())
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String?
  doctor           User?           @relation("AdmissionDoctor", fields: [doctorId], references: [id])
  wardType         String?
  roomNumber       String?
  bedId            String?
  bed              Bed?            @relation(fields: [bedId], references: [id])
  reason           String?
  status           AdmissionStatus @default(ADMITTED)
  admittedAt       DateTime        @default(now())
  dischargedAt     DateTime?
  dischargeSummary String?

  dischargeSummaryRecord DischargeSummaryRecord?
  bills                  Bill[]
  icuRounds              IcuRound[]
  surgeries              Surgery[]

  @@index([patientId])
  @@index([status])
  @@index([bedId])
}

model Prescription {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User     @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  encounterId   String?
  encounter     Encounter? @relation(fields: [encounterId], references: [id])
  diagnosis     String?
  notes         String?
  issuedAt      DateTime @default(now())

  items PrescriptionItem[]
  dispenses PharmacyDispense[]

  @@index([patientId])
  @@index([encounterId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?

  @@index([prescriptionId])
}

enum BillStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum BillType {
  OPD
  IPD
  EMERGENCY
  LAB
  RADIOLOGY
  PHARMACY
}

enum PayerType {
  SELF
  INSURANCE
  CORPORATE
}

model Bill {
  id             String     @id @default(cuid())
  billNumber     String     @unique
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId    String?
  admission      Admission? @relation(fields: [admissionId], references: [id])
  type           BillType   @default(OPD)
  payerType      PayerType  @default(SELF)
  insuranceId    String?
  insurance      Insurance? @relation(fields: [insuranceId], references: [id])
  corporateAccountId String?
  corporateAccount   CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  packageId      String?
  package        Package?   @relation(fields: [packageId], references: [id])
  totalAmount    Decimal    @db.Decimal(12, 2) @default(0)
  discountAmount Decimal    @db.Decimal(12, 2) @default(0)
  cgstAmount     Decimal    @db.Decimal(12, 2) @default(0)
  sgstAmount     Decimal    @db.Decimal(12, 2) @default(0)
  taxAmount      Decimal    @db.Decimal(12, 2) @default(0)
  netAmount      Decimal    @db.Decimal(12, 2) @default(0)
  amountPaid     Decimal    @db.Decimal(12, 2) @default(0)
  balanceDue     Decimal    @db.Decimal(12, 2) @default(0)
  status         BillStatus @default(PENDING)
  issuedAt       DateTime   @default(now())
  cancelledAt    DateTime?

  items              BillItem[]
  payments           Payment[]
  refunds            Refund[]
  advanceAdjustments AdvanceAdjustment[]
  insuranceClaim     InsuranceClaim?

  @@index([patientId])
  @@index([status])
  @@index([type])
}

model BillItem {
  id             String  @id @default(cuid())
  billId         String
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  description    String
  hsnCode        String?
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRatePercent Decimal @db.Decimal(5, 2) @default(0)
  taxAmount      Decimal @db.Decimal(12, 2) @default(0)
  amount         Decimal @db.Decimal(12, 2)

  @@index([billId])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  INSURANCE
  WALLET
  ADVANCE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  billId          String?
  bill            Bill?         @relation(fields: [billId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(SUCCESS)
  referenceNumber String?
  gatewayProvider String?
  cashSessionId   String?
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id])
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  paidAt          DateTime      @default(now())

  refunds Refund[]

  @@index([patientId])
  @@index([cashSessionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Enterprise Billing & Finance
// ─────────────────────────────────────────────────────────────────────────

model Package {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  includedItems String[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  bills Bill[]
}

model CorporateAccount {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String?
  contactPhone String?
  contactEmail String?
  gstin        String?
  creditLimit  Decimal? @db.Decimal(12, 2)
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  patients CorporatePatient[]
  bills    Bill[]
}

model CorporatePatient {
  id                 String           @id @default(cuid())
  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  employeeId         String?
  createdAt          DateTime         @default(now())

  @@unique([corporateAccountId, patientId])
  @@index([patientId])
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

model InsuranceClaim {
  id              String      @id @default(cuid())
  billId          String      @unique
  bill            Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceId     String
  insurance       Insurance   @relation(fields: [insuranceId], references: [id])
  claimNumber     String      @unique
  claimedAmount   Decimal     @db.Decimal(12, 2)
  approvedAmount  Decimal?    @db.Decimal(12, 2)
  status          ClaimStatus @default(DRAFT)
  submittedAt     DateTime?
  settledAt       DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([patientId])
  @@index([status])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Refund {
  id            String        @id @default(cuid())
  billId        String?
  bill          Bill?         @relation(fields: [billId], references: [id])
  paymentId     String?
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  reason        String
  method        PaymentMethod
  status        RefundStatus  @default(PENDING)
  requestedAt   DateTime      @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?         @relation("RefundProcessedBy", fields: [processedById], references: [id])

  @@index([patientId])
  @@index([status])
}

model PatientAdvance {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  balance         Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?
  receivedById    String?
  receivedBy      User?         @relation("AdvanceReceivedBy", fields: [receivedById], references: [id])
  paidAt          DateTime      @default(now())
  notes           String?

  adjustments AdvanceAdjustment[]

  @@index([patientId])
}

model AdvanceAdjustment {
  id         String         @id @default(cuid())
  advanceId  String
  advance    PatientAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  billId     String
  bill       Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(12, 2)
  adjustedAt DateTime       @default(now())

  @@index([advanceId])
  @@index([billId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id              String            @id @default(cuid())
  openedById      String
  openedBy        User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedById      String?
  closedBy        User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  openingBalance  Decimal           @db.Decimal(12, 2) @default(0)
  closingBalance  Decimal?          @db.Decimal(12, 2)
  expectedClosing Decimal?          @db.Decimal(12, 2)
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  notes           String?

  payments Payment[]

  @@index([status])
}

enum ExpenseCategory {
  SALARY
  UTILITIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  RENT
  EQUIPMENT
  OTHER
}

model Expense {
  id              String          @id @default(cuid())
  category        ExpenseCategory
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime        @default(now())
  paidTo          String?
  method          PaymentMethod
  referenceNumber String?
  recordedById    String?
  recordedBy      User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([category])
  @@index([expenseDate])
}

// ─────────────────────────────────────────────────────────────────────────
// CRM — Notes, Follow-ups, Communication log, Feedback
// ─────────────────────────────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel      CommChannel
  direction    MessageDirection  @default(OUTBOUND)
  subject      String?
  body         String
  status       MessageStatus     @default(SENT)
  sentById     String?
  sentBy       User?             @relation("MessageSentBy", fields: [sentById], references: [id])
  sentAt       DateTime          @default(now())

  @@index([patientId])
  @@index([channel])
}

enum NoteCategory {
  GENERAL
  CLINICAL
  BILLING
  FRONT_DESK
}

model PatientNote {
  id        String       @id @default(cuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  category  NoteCategory @default(GENERAL)
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([patientId])
}

enum FollowUpStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

model FollowUp {
  id            String         @id @default(cuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  dueDate       DateTime
  reason        String
  status        FollowUpStatus @default(PENDING)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([patientId])
  @@index([status, dueDate])
}

model Feedback {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  category      String?
  createdAt     DateTime     @default(now())

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — Electronic Medical Record (EMR)
//
// Encounter is the anchor for a single consultation: chief complaints,
// vitals, diagnoses, the SOAP note, and prescriptions issued during that
// visit all hang off it, so every consultation is permanently recorded as
// one unit rather than loose, disconnected notes.
// ─────────────────────────────────────────────────────────────────────────

enum EncounterStatus {
  DRAFT
  FINALIZED
}

model Encounter {
  id              String          @id @default(cuid())
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User            @relation("EncounterDoctor", fields: [doctorId], references: [id])
  appointmentId   String?
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  encounterDate   DateTime        @default(now())
  chiefComplaints String[]
  status          EncounterStatus @default(DRAFT)
  signedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vitals        Vitals[]
  diagnoses     Diagnosis[]
  clinicalNote  ClinicalNote?
  prescriptions Prescription[]
  reports       ClinicalReport[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]

  @@index([patientId])
  @@index([doctorId])
}

model Vitals {
  id              String    @id @default(cuid())
  encounterId     String
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId       String
  heightCm        Decimal?  @db.Decimal(5, 1)
  weightKg        Decimal?  @db.Decimal(5, 1)
  bmi             Decimal?  @db.Decimal(4, 1)
  temperatureC    Decimal?  @db.Decimal(4, 1)
  pulseBpm        Int?
  bpSystolic      Int?
  bpDiastolic     Int?
  spo2            Int?
  respiratoryRate Int?
  recordedAt      DateTime  @default(now())

  @@index([encounterId])
  @@index([patientId])
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

model Diagnosis {
  id          String          @id @default(cuid())
  encounterId String
  encounter   Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  description String
  icdCode     String?
  type        DiagnosisType   @default(PRIMARY)
  status      DiagnosisStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())

  @@index([encounterId])
  @@index([patientId])
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
}

model ClinicalNote {
  id          String             @id @default(cuid())
  encounterId String             @unique
  encounter   Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  doctorId    String
  doctor      User               @relation("ClinicalNoteDoctor", fields: [doctorId], references: [id])
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  status      ClinicalNoteStatus @default(DRAFT)
  version     Int                @default(1)
  signedAt    DateTime?
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())

  versions ClinicalNoteVersion[]

  @@index([patientId])
}

model ClinicalNoteVersion {
  id             String       @id @default(cuid())
  clinicalNoteId String
  clinicalNote   ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Cascade)
  versionNumber  Int
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  savedAt        DateTime     @default(now())

  @@index([clinicalNoteId])
}

model MedicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description String
  occurredOn  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

model FamilyHistoryEntry {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model SurgicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure   String
  surgeryDate DateTime?
  surgeon     String?
  hospital    String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

enum MedicationStatus {
  ACTIVE
  STOPPED
}

model CurrentMedication {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineName String
  dosage       String?
  frequency    String?
  startDate    DateTime?
  endDate      DateTime?
  status       MedicationStatus  @default(ACTIVE)
  prescribedBy String?
  notes        String?
  createdAt    DateTime          @default(now())

  @@index([patientId])
}

enum DoctorTemplateType {
  SOAP
  PRESCRIPTION
  CERTIFICATE
}

model DoctorTemplate {
  id         String             @id @default(cuid())
  doctorId   String
  doctor     User               @relation("DoctorTemplateOwner", fields: [doctorId], references: [id], onDelete: Cascade)
  name       String
  type       DoctorTemplateType
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  content    String?
  createdAt  DateTime           @default(now())

  @@index([doctorId])
}

model DigitalSignature {
  id           String   @id @default(cuid())
  doctorId     String   @unique
  doctor       User     @relation("DoctorSignature", fields: [doctorId], references: [id], onDelete: Cascade)
  signatureUrl String
  updatedAt    DateTime @updatedAt
}

enum ClinicalReportType {
  LAB
  RADIOLOGY
}

enum ClinicalReportStatus {
  PENDING
  COMPLETED
}

model ClinicalReport {
  id            String               @id @default(cuid())
  patientId     String
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?                @relation("ClinicalReportDoctor", fields: [doctorId], references: [id])
  encounterId   String?
  encounter     Encounter?           @relation(fields: [encounterId], references: [id])
  type          ClinicalReportType
  title         String
  modality      String?
  findings      String?
  impression    String?
  status        ClinicalReportStatus @default(PENDING)
  reportDate    DateTime             @default(now())
  attachmentUrl String?
  createdAt     DateTime             @default(now())

  labResults LabResultItem[]
  labOrder        LabOrder?
  radiologyOrder  RadiologyOrder?

  @@index([patientId])
  @@index([type])
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

model LabResultItem {
  id             String         @id @default(cuid())
  reportId       String
  report         ClinicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  testName       String
  value          String
  unit           String?
  referenceRange String?
  flag           ResultFlag     @default(NORMAL)

  @@index([reportId])
}

model DischargeSummaryRecord {
  id                     String    @id @default(cuid())
  admissionId            String    @unique
  admission              Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId              String
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId               String
  doctor                 User      @relation("DischargeSummaryDoctor", fields: [doctorId], references: [id])
  diagnosis              String?
  proceduresPerformed    String?
  hospitalCourse         String?
  medicationsOnDischarge String?
  followUpInstructions   String?
  conditionAtDischarge   String?
  signedAt               DateTime?
  createdAt              DateTime  @default(now())

  @@index([patientId])
}

enum ReferralUrgency {
  ROUTINE
  URGENT
}

model ReferralNote {
  id           String          @id @default(cuid())
  patientId    String
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromDoctorId String
  fromDoctor   User            @relation("ReferralFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctor     String
  toSpecialty  String?
  reason       String
  notes        String?
  urgency      ReferralUrgency @default(ROUTINE)
  signedAt     DateTime?
  createdAt    DateTime        @default(now())

  @@index([patientId])
}

enum CertificateType {
  FITNESS
  SICK_LEAVE
  MEDICAL
  VACCINATION
  OTHER
}

model Certificate {
  id        String          @id @default(cuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User            @relation("CertificateDoctor", fields: [doctorId], references: [id])
  type      CertificateType
  title     String
  content   String
  validFrom DateTime?
  validTo   DateTime?
  signedAt  DateTime?
  createdAt DateTime        @default(now())

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4 — Hospital Operations Backbone
//
// Bed/ward/ICU capacity, OT scheduling, emergency triage, ambulance
// dispatch, lab/radiology order tracking with sample barcodes, pharmacy
// inventory with purchase orders, biomedical assets, and facility
// (housekeeping/laundry/maintenance) tickets.
// ─────────────────────────────────────────────────────────────────────────

enum WardType {
  GENERAL
  PRIVATE
  SEMI_PRIVATE
  ICU
  NICU
  MATERNITY
  EMERGENCY
  OT
}

model Ward {
  id        String   @id @default(cuid())
  name      String
  type      WardType @default(GENERAL)
  floor     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  beds Bed[]

  @@index([type])
}

enum BedType {
  GENERAL
  ICU
  VENTILATOR
  ISOLATION
  PEDIATRIC
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

model Bed {
  id        String    @id @default(cuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber String
  type      BedType   @default(GENERAL)
  status    BedStatus @default(AVAILABLE)
  dailyRate Decimal?  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime  @default(now())

  admissions     Admission[]
  emergencyCases EmergencyCase[]

  @@unique([wardId, bedNumber])
  @@index([status])
  @@index([type])
}

model IcuRound {
  id              String    @id @default(cuid())
  admissionId     String
  admission       Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  recordedById    String?
  recordedBy      User?     @relation("IcuRoundRecordedBy", fields: [recordedById], references: [id])
  pulseBpm        Int?
  bpSystolic      Int?
  bpDiastolic     Int?
  spo2            Int?
  temperatureC    Decimal?  @db.Decimal(4, 1)
  respiratoryRate Int?
  ventilatorMode  String?
  gcsScore        Int?
  notes           String?
  recordedAt      DateTime  @default(now())

  @@index([admissionId])
}

enum OtStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  CLEANING
}

model OperationTheatre {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  status    OtStatus @default(AVAILABLE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  surgeries Surgery[]
}

enum SurgeryStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

model Surgery {
  id             String           @id @default(cuid())
  otId           String
  ot             OperationTheatre @relation(fields: [otId], references: [id])
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId    String?
  admission      Admission?       @relation(fields: [admissionId], references: [id])
  surgeonId      String
  surgeon        User             @relation("SurgeryLeadSurgeon", fields: [surgeonId], references: [id])
  procedureName  String
  anesthesiaType String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  status         SurgeryStatus    @default(SCHEDULED)
  notes          String?
  createdAt      DateTime         @default(now())

  @@index([otId, scheduledStart])
  @@index([patientId])
  @@index([status])
}

enum TriageLevel {
  RESUSCITATION
  EMERGENT
  URGENT
  LESS_URGENT
  NON_URGENT
}

enum ArrivalMode {
  AMBULANCE
  WALK_IN
  REFERRED
  POLICE
}

enum EmergencyStatus {
  WAITING
  IN_TREATMENT
  ADMITTED
  DISCHARGED
  REFERRED_OUT
  LEFT_WITHOUT_TREATMENT
}

model EmergencyCase {
  id                String          @id @default(cuid())
  caseNumber        String          @unique
  patientId         String?
  patient           Patient?        @relation(fields: [patientId], references: [id])
  walkInName        String?
  walkInPhone       String?
  triageLevel       TriageLevel     @default(URGENT)
  chiefComplaint    String
  arrivalMode       ArrivalMode     @default(WALK_IN)
  broughtBy         String?
  status            EmergencyStatus @default(WAITING)
  attendingDoctorId String?
  attendingDoctor   User?           @relation("EmergencyAttending", fields: [attendingDoctorId], references: [id])
  bedId             String?
  bed               Bed?            @relation(fields: [bedId], references: [id])
  disposition       String?
  arrivedAt         DateTime        @default(now())
  seenAt            DateTime?
  dischargedAt      DateTime?
  notes             String?

  @@index([status])
  @@index([triageLevel])
}

enum AmbulanceStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
}

model Ambulance {
  id            String          @id @default(cuid())
  vehicleNumber String          @unique
  driverName    String?
  driverPhone   String?
  status        AmbulanceStatus @default(AVAILABLE)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  trips AmbulanceTrip[]
}

enum TripPurpose {
  PICKUP
  DROP
  TRANSFER
}

enum TripStatus {
  REQUESTED
  DISPATCHED
  COMPLETED
  CANCELLED
}

model AmbulanceTrip {
  id             String      @id @default(cuid())
  ambulanceId    String
  ambulance      Ambulance   @relation(fields: [ambulanceId], references: [id])
  patientId      String?
  patient        Patient?    @relation(fields: [patientId], references: [id])
  purpose        TripPurpose @default(PICKUP)
  pickupLocation String?
  dropLocation   String?
  status         TripStatus  @default(REQUESTED)
  requestedAt    DateTime    @default(now())
  dispatchedAt   DateTime?
  completedAt    DateTime?
  notes          String?

  @@index([ambulanceId])
  @@index([status])
}

enum OrderPriority {
  ROUTINE
  STAT
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_LAB
  RESULTED
  CANCELLED
}

model LabOrder {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String?
  doctor            User?           @relation("LabOrderDoctor", fields: [doctorId], references: [id])
  encounterId       String?
  encounter         Encounter?      @relation(fields: [encounterId], references: [id])
  testName          String
  priority          OrderPriority   @default(ROUTINE)
  status            LabOrderStatus  @default(ORDERED)
  clinicalReportId  String?         @unique
  clinicalReport    ClinicalReport? @relation(fields: [clinicalReportId], references: [id])
  orderedAt         DateTime        @default(now())

  sample Sample?

  @@index([patientId])
  @@index([status])
}

enum SampleType {
  BLOOD
  URINE
  STOOL
  SPUTUM
  SWAB
  TISSUE
  OTHER
}

enum SampleStatus {
  PENDING_COLLECTION
  COLLECTED
  IN_TRANSIT
  RECEIVED
  REJECTED
  DISPOSED
}

model Sample {
  id              String       @id @default(cuid())
  barcode         String       @unique
  labOrderId      String       @unique
  labOrder        LabOrder     @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  type            SampleType   @default(BLOOD)
  status          SampleStatus @default(PENDING_COLLECTION)
  collectedById   String?
  collectedBy     User?        @relation("SampleCollectedBy", fields: [collectedById], references: [id])
  collectedAt     DateTime?
  receivedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())

  @@index([status])
}

enum RadiologyModality {
  XRAY
  CT
  MRI
  ULTRASOUND
  MAMMOGRAPHY
  OTHER
}

enum RadiologyOrderStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RadiologyOrder {
  id               String               @id @default(cuid())
  orderNumber      String               @unique
  patientId        String
  patient          Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String?
  doctor           User?                @relation("RadiologyOrderDoctor", fields: [doctorId], references: [id])
  encounterId      String?
  encounter        Encounter?           @relation(fields: [encounterId], references: [id])
  modality         RadiologyModality
  bodyPart         String
  priority         OrderPriority        @default(ROUTINE)
  status           RadiologyOrderStatus @default(ORDERED)
  scheduledAt      DateTime?
  clinicalReportId String?              @unique
  clinicalReport   ClinicalReport?      @relation(fields: [clinicalReportId], references: [id])
  orderedAt        DateTime             @default(now())

  images PacsImage[]

  @@index([patientId])
  @@index([status])
}

model PacsImage {
  id                String         @id @default(cuid())
  radiologyOrderId  String
  radiologyOrder    RadiologyOrder @relation(fields: [radiologyOrderId], references: [id], onDelete: Cascade)
  imageUrl          String
  seriesDescription String?
  uploadedAt        DateTime       @default(now())

  @@index([radiologyOrderId])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstin       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchaseOrders  PurchaseOrder[]
  medicineBatches MedicineBatch[]
  equipment       Equipment[]
}

enum MedicineUnit {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  OTHER
}

model Medicine {
  id           String       @id @default(cuid())
  name         String
  genericName  String?
  category     String?
  unit         MedicineUnit @default(TABLET)
  hsnCode      String?
  reorderLevel Int          @default(10)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  batches            MedicineBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  dispenseItems      PharmacyDispenseItem[]

  @@index([name])
}

model MedicineBatch {
  id            String   @id @default(cuid())
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber   String
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  expiryDate    DateTime
  quantity      Int      @default(0)
  mrp           Decimal  @db.Decimal(10, 2)
  purchasePrice Decimal? @db.Decimal(10, 2)
  receivedAt    DateTime @default(now())

  dispenseItems PharmacyDispenseItem[]

  @@index([medicineId])
  @@index([expiryDate])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  orderedAt    DateTime            @default(now())
  expectedDate DateTime?
  receivedAt   DateTime?
  notes        String?
  createdById  String?
  createdBy    User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])

  items PurchaseOrderItem[]

  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id         String        @id @default(cuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine      @relation(fields: [medicineId], references: [id])
  quantity   Int
  unitCost   Decimal       @db.Decimal(10, 2)

  @@index([poId])
}

model PharmacyDispense {
  id             String        @id @default(cuid())
  dispenseNumber String        @unique
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  dispensedById  String?
  dispensedBy    User?         @relation("PharmacyDispensedBy", fields: [dispensedById], references: [id])
  dispensedAt    DateTime      @default(now())

  items PharmacyDispenseItem[]

  @@index([patientId])
}

model PharmacyDispenseItem {
  id         String           @id @default(cuid())
  dispenseId String
  dispense   PharmacyDispense @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine         @relation(fields: [medicineId], references: [id])
  batchId    String?
  batch      MedicineBatch?   @relation(fields: [batchId], references: [id])
  quantity   Int
  unitPrice  Decimal          @db.Decimal(10, 2)

  @@index([dispenseId])
}

enum EquipmentCategory {
  BIOMEDICAL
  IT
  FURNITURE
  VEHICLE
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

model Equipment {
  id              String            @id @default(cuid())
  assetCode       String            @unique
  name            String
  category        EquipmentCategory @default(BIOMEDICAL)
  department      String?
  location        String?
  vendorId        String?
  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  lastServiceDate DateTime?
  nextServiceDue  DateTime?
  status          EquipmentStatus   @default(OPERATIONAL)
  notes           String?
  createdAt       DateTime          @default(now())

  tickets FacilityTicket[]

  @@index([status])
  @@index([category])
}

enum TicketCategory {
  HOUSEKEEPING
  LAUNDRY
  MAINTENANCE
  EQUIPMENT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model FacilityTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  category     TicketCategory
  title        String
  description  String?
  location     String?
  equipmentId  String?
  equipment    Equipment?     @relation(fields: [equipmentId], references: [id])
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  reportedById String?
  reportedBy   User?          @relation("TicketReportedBy", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  reportedAt   DateTime       @default(now())
  resolvedAt   DateTime?
  notes        String?

  @@index([category])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 5 — HRMS (Human Resource Management System)
//
// Employee is a 1:1 HR extension of User — it never touches the auth/identity
// surface, it only adds the HR profile fields other HR modules hang off.
// ─────────────────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  headId    String?
  head      User?    @relation("DepartmentHead", fields: [headId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  designations Designation[]
  employees    Employee[]
  jobOpenings  JobOpening[]
}

model Designation {
  id           String      @id @default(cuid())
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  level        String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  employees Employee[]

  @@index([departmentId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
}

model Employee {
  id                    String         @id @default(cuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode          String         @unique
  departmentId          String?
  department            Department?    @relation(fields: [departmentId], references: [id])
  designationId         String?
  designation           Designation?   @relation(fields: [designationId], references: [id])
  reportingManagerId    String?
  reportingManager      Employee?      @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports         Employee[]     @relation("ManagerReports")
  dateOfJoining          DateTime
  dob                   DateTime?
  gender                Gender?
  maritalStatus         MaritalStatus?
  bloodGroup            BloodGroup?
  employmentType        EmploymentType @default(FULL_TIME)
  status                EmployeeStatus @default(ACTIVE)
  address                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl               String?
  idCardIssuedAt         DateTime?
  createdAt              DateTime       @default(now())

  attendanceRecords AttendanceRecord[]
  biometricLogs     BiometricLog[]
  salaryStructure   SalaryStructure?
  payslips          Payslip[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  shiftAssignments  ShiftAssignment[]
  performanceReviews PerformanceReview[]
  trainingEnrollments TrainingEnrollment[]
  onboardingTasks    OnboardingTask[]
  exitRequest        ExitRequest?
  documents          EmployeeDocument[]

  @@index([departmentId])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus  @default(PRESENT)
  source     AttendanceSource  @default(MANUAL)
  workHours  Decimal?          @db.Decimal(4, 1)
  notes      String?
  createdAt  DateTime          @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model BiometricDevice {
  id       String   @id @default(cuid())
  name     String
  location String?
  active   Boolean  @default(true)

  logs BiometricLog[]
}

enum PunchType {
  IN
  OUT
}

model BiometricLog {
  id         String    @id @default(cuid())
  deviceId   String
  device     BiometricDevice @relation(fields: [deviceId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punchTime  DateTime
  punchType  PunchType
  createdAt  DateTime  @default(now())

  @@index([employeeId, punchTime])
}

model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic            Decimal  @db.Decimal(10, 2)
  hra              Decimal  @db.Decimal(10, 2) @default(0)
  conveyance       Decimal  @db.Decimal(10, 2) @default(0)
  medicalAllowance Decimal  @db.Decimal(10, 2) @default(0)
  specialAllowance Decimal  @db.Decimal(10, 2) @default(0)
  pf               Decimal  @db.Decimal(10, 2) @default(0)
  professionalTax  Decimal  @db.Decimal(10, 2) @default(0)
  otherDeductions  Decimal  @db.Decimal(10, 2) @default(0)
  effectiveFrom    DateTime @default(now())
  createdAt        DateTime @default(now())
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

model PayrollRun {
  id          String           @id @default(cuid())
  month       Int
  year        Int
  status      PayrollRunStatus @default(DRAFT)
  processedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  payslips Payslip[]

  @@unique([month, year])
}

model Payslip {
  id               String     @id @default(cuid())
  payrollRunId     String
  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic            Decimal    @db.Decimal(10, 2)
  hra              Decimal    @db.Decimal(10, 2)
  conveyance       Decimal    @db.Decimal(10, 2)
  medicalAllowance Decimal    @db.Decimal(10, 2)
  specialAllowance Decimal    @db.Decimal(10, 2)
  grossEarnings    Decimal    @db.Decimal(10, 2)
  pf               Decimal    @db.Decimal(10, 2)
  professionalTax  Decimal    @db.Decimal(10, 2)
  otherDeductions  Decimal    @db.Decimal(10, 2)
  totalDeductions  Decimal    @db.Decimal(10, 2)
  netPay           Decimal    @db.Decimal(10, 2)
  generatedAt      DateTime   @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model LeaveType {
  id           String   @id @default(cuid())
  name         String   @unique
  daysPerYear  Int
  paid         Boolean  @default(true)
  active       Boolean  @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Int
  used        Int       @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id          String              @id @default(cuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType           @relation(fields: [leaveTypeId], references: [id])
  fromDate    DateTime
  toDate      DateTime
  days        Int
  reason      String?
  status      LeaveRequestStatus  @default(PENDING)
  approvedById String?
  approvedBy   User?              @relation("LeaveApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([employeeId])
  @@index([status])
}

model Shift {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  active    Boolean  @default(true)

  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  date       DateTime

  @@unique([employeeId, date])
  @@index([date])
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model PerformanceReview {
  id           String       @id @default(cuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User         @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  periodLabel  String
  rating       Int
  strengths    String?
  improvements String?
  goals        String?
  status       ReviewStatus @default(DRAFT)
  reviewDate   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  @@index([employeeId])
}

enum TrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model TrainingProgram {
  id             String         @id @default(cuid())
  title          String
  description    String?
  trainer        String?
  scheduledAt    DateTime
  durationHours  Decimal?       @db.Decimal(4, 1)
  status         TrainingStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now())

  enrollments TrainingEnrollment[]
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  NO_SHOW
}

model TrainingEnrollment {
  id         String            @id @default(cuid())
  programId  String
  program    TrainingProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus  @default(ENROLLED)
  score      Decimal?          @db.Decimal(5, 2)
  createdAt  DateTime          @default(now())

  @@unique([programId, employeeId])
}

enum JobOpeningStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model JobOpening {
  id           String           @id @default(cuid())
  title        String
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  positions    Int              @default(1)
  description  String?
  status       JobOpeningStatus @default(OPEN)
  postedById   String?
  postedBy     User?            @relation("JobOpeningPostedBy", fields: [postedById], references: [id])
  postedAt     DateTime         @default(now())

  candidates Candidate[]

  @@index([status])
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Candidate {
  id           String         @id @default(cuid())
  jobOpeningId String
  jobOpening   JobOpening     @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  stage        CandidateStage @default(APPLIED)
  notes        String?
  appliedAt    DateTime       @default(now())

  @@index([jobOpeningId])
  @@index([stage])
}

enum OnboardingTaskStatus {
  PENDING
  DONE
}

model OnboardingTask {
  id           String                @id @default(cuid())
  employeeId   String
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime?
  status       OnboardingTaskStatus  @default(PENDING)
  assignedToId String?
  assignedTo   User?                 @relation("OnboardingAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime              @default(now())

  @@index([employeeId])
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
}

model Announcement {
  id           String               @id @default(cuid())
  title        String
  body         String
  postedById   String
  postedBy     User                 @relation("AnnouncementPostedBy", fields: [postedById], references: [id])
  audience     AnnouncementAudience @default(ALL)
  departmentId String?
  pinned       Boolean              @default(false)
  createdAt    DateTime             @default(now())

  @@index([audience])
}

model ChatChannel {
  id        String   @id @default(cuid())
  name      String
  isDirect  Boolean  @default(false)
  createdAt DateTime @default(now())

  members  ChatChannelMember[]
  messages ChatMessage[]
}

model ChatChannelMember {
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatChannelMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now())

  @@id([channelId, userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation("ChatMessageSender", fields: [senderId], references: [id])
  body      String
  sentAt    DateTime    @default(now())

  @@index([channelId, sentAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  assignedToId String
  assignedTo   User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User         @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  dueDate      DateTime?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  createdAt    DateTime     @default(now())

  @@index([assignedToId])
  @@index([status])
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id           String        @id @default(cuid())
  title        String
  organizerId  String
  organizer    User          @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  startTime    DateTime
  endTime      DateTime
  location     String?
  meetingLink  String?
  notes        String?
  status       MeetingStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())

  attendees MeetingAttendee[]

  @@index([startTime])
}

enum AttendeeResponse {
  PENDING
  ACCEPTED
  DECLINED
}

model MeetingAttendee {
  id       String           @id @default(cuid())
  meetingId String
  meeting   Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("MeetingAttendeeUser", fields: [userId], references: [id])
  response  AttendeeResponse @default(PENDING)

  @@unique([meetingId, userId])
}

enum ExitStatus {
  PENDING
  APPROVED
  COMPLETED
  WITHDRAWN
}

model ExitRequest {
  id                  String     @id @default(cuid())
  employeeId          String     @unique
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resignationDate     DateTime
  lastWorkingDate     DateTime
  reason              String?
  status              ExitStatus @default(PENDING)
  clearanceIT         Boolean    @default(false)
  clearanceFinance    Boolean    @default(false)
  clearanceAdmin      Boolean    @default(false)
  exitInterviewNotes  String?
  approvedById        String?
  approvedBy          User?      @relation("ExitApprovedBy", fields: [approvedById], references: [id])
  createdAt           DateTime   @default(now())

  @@index([status])
}

enum EmployeeDocCategory {
  ID_PROOF
  CONTRACT
  CERTIFICATE
  RESUME
  OTHER
}

model EmployeeDocument {
  id         String              @id @default(cuid())
  employeeId String
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  category   EmployeeDocCategory @default(OTHER)
  fileUrl    String
  uploadedAt DateTime            @default(now())

  @@index([employeeId])
}
