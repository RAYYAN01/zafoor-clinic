<%- include('../partials/head', { title, description }) %>
<%- include('../partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:px-8">
      <p class="section-label">Services</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-dark sm:text-4xl">Consultations we offer</h1>
      <p class="mx-auto mt-4 max-w-xl text-base text-muted">Choose a review below to learn more, or book directly.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <% if (services.length === 0) { %>
    <p class="text-center text-sm text-muted">Services will be listed here shortly. Please call the clinic to book.</p>
    <% } else { %>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% services.forEach(function (service) { %>
      <div class="card flex flex-col p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/50 text-primary">＋</span>
        <h2 class="mt-4 text-base font-semibold text-dark"><%= service.name %></h2>
        <% if (service.shortDescription) { %><p class="mt-2 text-sm text-muted"><%= service.shortDescription %></p><% } %>
        <p class="mt-3 text-xs text-muted"><%= service.durationMinutes %> min consultation<% if (service.price) { %> · ₹<%= service.price %><% } %></p>
        <div class="mt-4 flex items-center gap-4 text-sm font-medium">
          <a class="text-primary hover:underline" href="/services/<%= service.slug %>">Learn More</a>
          <a class="text-primary hover:underline" href="/book?service=<%= service.slug %>">Book Review</a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="section-label text-center">Real Results</p>
      <h2 class="mt-2 text-center text-2xl font-semibold tracking-tight text-dark sm:text-3xl">Before &amp; after</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        <img src="/images/before-after/hair-treatment.jpeg" alt="Hair treatment before and after result at Zafoor Clinic" class="w-full rounded-2xl object-cover shadow-soft" loading="lazy" />
        <img src="/images/before-after/hydra-facial.jpeg" alt="Hydra facial before and after result at Zafoor Clinic" class="w-full rounded-2xl object-cover shadow-soft" loading="lazy" />
        <img src="/images/before-after/fire-ice-facial.jpeg" alt="Fire and ice facial before and after result at Zafoor Clinic" class="w-full rounded-2xl object-cover shadow-soft" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="section-label text-center">Inside the Clinic</p>
    <h2 class="mt-2 text-center text-2xl font-semibold tracking-tight text-dark sm:text-3xl">See a treatment in progress</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <div class="card overflow-hidden">
        <video class="aspect-video w-full bg-dark object-cover" controls preload="metadata" playsinline>
          <source src="/videos/procedure-videos/laser-treatment.mp4" type="video/mp4" />
        </video>
        <p class="p-4 text-sm text-muted">Laser treatment at Zafoor Clinic</p>
      </div>
      <div class="card overflow-hidden">
        <video class="aspect-video w-full bg-dark object-cover" controls preload="metadata" playsinline>
          <source src="/videos/procedure-videos/gfc-therapy.mp4" type="video/mp4" />
        </video>
        <p class="p-4 text-sm text-muted">GFC therapy at Zafoor Clinic</p>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer', { clinic }) %>
