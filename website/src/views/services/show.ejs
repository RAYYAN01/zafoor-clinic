<%- include('../partials/head', { title, description }) %>
<%- include('../partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
      <a href="/services" class="text-sm font-medium text-primary hover:underline">← All services</a>
      <p class="section-label mt-4">Service</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-dark sm:text-4xl"><%= service.name %></h1>
      <% if (service.shortDescription) { %><p class="mt-3 text-base text-muted"><%= service.shortDescription %></p><% } %>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/book?service=<%= service.slug %>" class="btn-primary">Book This Review</a>
        <a href="tel:<%= clinic.phone %>" class="btn-secondary">Call <%= clinic.phone %></a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="card p-5">
        <p class="section-label">Duration</p>
        <p class="mt-1 text-sm text-ink"><%= service.durationMinutes %> minutes</p>
      </div>
      <% if (service.price) { %>
      <div class="card p-5">
        <p class="section-label">Consultation fee</p>
        <p class="mt-1 text-sm text-ink">₹<%= service.price %></p>
      </div>
      <% } %>
      <div class="card p-5">
        <p class="section-label">Availability</p>
        <p class="mt-1 text-sm text-ink">Mon – Sat, <%= clinic.weekdayOpen %> – <%= clinic.weekdayClose %></p>
      </div>
    </div>

    <% if (service.description) { %>
    <div class="mt-10">
      <p class="section-label">About this review</p>
      <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted"><%= service.description %></p>
    </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer', { clinic }) %>
