<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="section-label">Legal</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-dark">Terms &amp; Conditions</h1>
    <p class="mt-2 text-sm text-muted">Last updated: <%= new Date().toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" }) %></p>

    <div class="prose-sm mt-8 space-y-6 text-sm leading-relaxed text-ink/90">
      <p>
        These terms govern your use of this website and the appointment booking service offered by Zafoor
        Clinic. By booking an appointment through this site, you agree to the terms below.
      </p>

      <h2 class="text-base font-semibold text-dark">Appointments</h2>
      <p>
        Booking a slot through this website reserves an appointment time with Zafoor Clinic, subject to
        confirmation by clinic staff. We aim to honour every booked slot, but appointments may occasionally
        need to be rescheduled — if that happens, we will try to reach you using the contact details you
        provided.
      </p>

      <h2 class="text-base font-semibold text-dark">Accuracy of information</h2>
      <p>
        Please provide accurate contact and personal details when booking. Incorrect information may delay
        confirmation or prevent us from reaching you about your appointment.
      </p>

      <h2 class="text-base font-semibold text-dark">Clinic hours</h2>
      <p>
        The clinic operates Monday to Saturday, <%= clinic.weekdayOpen %> to <%= clinic.weekdayClose %>, and is
        closed on Sundays. Timings may change for public holidays; please call ahead if in doubt.
      </p>

      <h2 class="text-base font-semibold text-dark">Medical advice</h2>
      <p>
        Content on this website is for general information only and is not a substitute for professional
        medical advice, diagnosis, or treatment. Always consult the doctor during your visit for advice specific
        to your condition.
      </p>

      <h2 class="text-base font-semibold text-dark">Contact</h2>
      <p>
        Questions about these terms can be directed to <a class="text-primary hover:underline" href="mailto:<%= clinic.email %>"><%= clinic.email %></a>
        or <a class="text-primary hover:underline" href="tel:<%= clinic.phone %>"><%= clinic.phone %></a>.
      </p>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
