<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent/40 blur-3xl"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-24">
      <div>
        <p class="section-label">Zafoor Clinic</p>
        <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight text-dark sm:text-4xl lg:text-5xl">
          Trusted healthcare for your everyday health.
        </h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted">
          Consultations for hairfall, acne, thyroid, skin, diabetes and general health — right in George Town, Chennai.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/book" class="btn-primary">Book an Appointment</a>
          <a href="tel:<%= clinic.phone %>" class="btn-secondary">Call <%= clinic.phone %></a>
        </div>
      </div>

      <div class="relative pb-10 sm:pb-14">
        <img
          src="/images/clinic/storefront.png"
          alt="Zafoor Clinic entrance, George Town, Chennai"
          class="fade-up aspect-[4/5] w-full rounded-2xl object-cover shadow-soft sm:aspect-[5/4]"
        />
        <div class="glass-card absolute -bottom-2 left-1/2 w-[calc(100%-2rem)] -translate-x-1/2 rounded-2xl p-5 shadow-soft sm:-bottom-6 sm:left-6 sm:w-auto sm:min-w-[280px] sm:translate-x-0">
          <p class="section-label">Clinic Information</p>
          <dl class="mt-3 space-y-3 text-sm">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">⏰</span>
              <div>
                <dt class="font-medium text-ink">Clinic Timings</dt>
                <dd class="text-muted">Mon – Sat, <%= clinic.weekdayOpen %> – <%= clinic.weekdayClose %><br />Sunday: <%= clinic.sundayClosed ? "Closed" : "Open" %></dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">📞</span>
              <div>
                <dt class="font-medium text-ink">Reach Us</dt>
                <dd class="text-muted"><a class="hover:text-primary" href="tel:<%= clinic.phone %>"><%= clinic.phone %></a></dd>
              </div>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick actions -->
  <section class="border-b border-line bg-surface">
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-8 sm:grid-cols-3 sm:px-6 lg:px-8">
      <a href="/book" class="card flex items-center gap-3 p-5 transition-colors hover:border-primary/40">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">📅</span>
        <span class="text-sm font-medium text-ink">Book Appointment</span>
      </a>
      <a href="tel:<%= clinic.phone %>" class="card flex items-center gap-3 p-5 transition-colors hover:border-primary/40">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">📞</span>
        <span class="text-sm font-medium text-ink">Call Clinic</span>
      </a>
      <a href="/location" class="card flex items-center gap-3 p-5 transition-colors hover:border-primary/40">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">🧭</span>
        <span class="text-sm font-medium text-ink">Get Directions</span>
      </a>
    </div>
  </section>

  <!-- About -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="section-label">About Zafoor Clinic</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-dark sm:text-3xl">A neighbourhood clinic for everyday health concerns</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Zafoor Clinic in George Town, Chennai offers evening consultations for common health concerns — hair and skin,
        thyroid and diabetes reviews, and general health check-ins. We keep the booking process simple so you can be
        seen without unnecessary waiting.
      </p>
      <a href="/about" class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">Learn more about the clinic →</a>
    </div>
  </section>

  <!-- Services -->
  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="section-label">Services</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-dark sm:text-3xl">Consultations we offer</h2>
        </div>
        <a href="/services" class="text-sm font-medium text-primary hover:underline">View all services →</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <% services.forEach(function (service) { %>
        <div class="card flex flex-col p-6" data-reveal>
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/50 text-primary">＋</span>
          <h3 class="mt-4 text-base font-semibold text-dark"><%= service.name %></h3>
          <% if (service.shortDescription) { %>
          <p class="mt-2 text-sm text-muted"><%= service.shortDescription %></p>
          <% } %>
          <div class="mt-4 flex items-center gap-4 text-sm font-medium">
            <a class="text-primary hover:underline" href="/services/<%= service.slug %>">Learn More</a>
            <a class="text-primary hover:underline" href="/book?service=<%= service.slug %>">Book Review</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- How appointments work -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="section-label">How Appointments Work</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-dark sm:text-3xl">Booking takes a minute</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { n: "1", t: "Choose Service", d: "Pick the review that matches your concern." },
        { n: "2", t: "Choose Time", d: "See real open slots for our doctor." },
        { n: "3", t: "Confirm Appointment", d: "Share a few details and confirm." },
        { n: "4", t: "Visit Clinic", d: "Arrive at your slot, Mon–Sat, 6–10 PM." },
      ].forEach(function (step) { %>
      <div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-semibold text-white"><%= step.n %></span>
        <h3 class="mt-3 text-sm font-semibold text-dark"><%= step.t %></h3>
        <p class="mt-1 text-sm text-muted"><%= step.d %></p>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- Reviews -->
  <% if (reviews.length > 0) { %>
  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="section-label">Patient Reviews</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-dark sm:text-3xl">What patients say</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <% reviews.forEach(function (r) { %>
        <div class="card p-6">
          <div class="flex items-center gap-1 text-amber-500" aria-label="<%= r.rating %> out of 5 stars">
            <% for (let i = 0; i < 5; i++) { %><span><%= i < r.rating ? "★" : "☆" %></span><% } %>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink/90">&ldquo;<%= r.comment %>&rdquo;</p>
          <p class="mt-3 text-sm font-medium text-dark"><%= r.patientName %><% if (r.serviceName) { %> · <span class="text-muted"><%= r.serviceName %></span><% } %></p>
        </div>
        <% }) %>
      </div>
      <a href="/reviews" class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">Read more reviews →</a>
    </div>
  </section>
  <% } %>

  <!-- Clinic info strip -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="card p-6">
        <p class="section-label">Timings</p>
        <p class="mt-2 text-sm text-ink">Mon – Sat: <%= clinic.weekdayOpen %> – <%= clinic.weekdayClose %></p>
        <p class="text-sm text-ink">Sunday: <%= clinic.sundayClosed ? "Closed" : "Open" %></p>
      </div>
      <div class="card p-6">
        <p class="section-label">Location</p>
        <p class="mt-2 text-sm text-ink"><%= clinic.addressLine %></p>
      </div>
      <div class="card p-6">
        <p class="section-label">Contact</p>
        <p class="mt-2 text-sm text-ink"><a class="hover:text-primary" href="tel:<%= clinic.phone %>"><%= clinic.phone %></a></p>
        <p class="text-sm text-ink"><a class="hover:text-primary" href="mailto:<%= clinic.email %>"><%= clinic.email %></a></p>
      </div>
    </div>
  </section>

  <!-- FAQ preview -->
  <% if (faqs.length > 0) { %>
  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="section-label text-center">FAQ</p>
      <h2 class="mt-2 text-center text-2xl font-semibold tracking-tight text-dark sm:text-3xl">Common questions</h2>
      <div class="mt-8 divide-y divide-line">
        <% faqs.forEach(function (faq) { %>
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium text-ink">
            <%= faq.question %>
            <span class="ml-4 text-muted transition-transform group-open:rotate-45">＋</span>
          </summary>
          <p class="mt-2 text-sm text-muted"><%= faq.answer %></p>
        </details>
        <% }) %>
      </div>
      <a href="/faq" class="mt-6 block text-center text-sm font-medium text-primary hover:underline">View all FAQs →</a>
    </div>
  </section>
  <% } %>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl bg-dark px-6 py-12 text-center sm:px-12">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Book your consultation</h2>
      <p class="mt-2 text-sm text-white/70">Open Monday to Saturday, <%= clinic.weekdayOpen %> – <%= clinic.weekdayClose %>.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/book" class="btn-primary">Book an Appointment</a>
        <a href="tel:<%= clinic.phone %>" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10">Call <%= clinic.phone %></a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
