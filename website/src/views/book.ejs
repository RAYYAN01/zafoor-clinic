<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
      <p class="section-label text-center">Book an Appointment</p>
      <h1 class="mt-2 text-center text-2xl font-semibold tracking-tight text-dark sm:text-3xl">A few quick steps</h1>

      <!-- Step indicator -->
      <ol class="mt-8 flex items-center justify-center gap-2 text-xs font-medium text-muted" id="step-indicator">
        <li data-step-dot="1" class="flex items-center gap-2"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-white">1</span><span class="hidden sm:inline">Service</span></li>
        <li class="h-px w-6 bg-line"></li>
        <li data-step-dot="2" class="flex items-center gap-2"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-line text-muted">2</span><span class="hidden sm:inline">Date</span></li>
        <li class="h-px w-6 bg-line"></li>
        <li data-step-dot="3" class="flex items-center gap-2"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-line text-muted">3</span><span class="hidden sm:inline">Time</span></li>
        <li class="h-px w-6 bg-line"></li>
        <li data-step-dot="4" class="flex items-center gap-2"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-line text-muted">4</span><span class="hidden sm:inline">Your Info</span></li>
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="card p-6 sm:p-8" id="booking-app" data-preselected="<%= preselectedSlug %>">
      <!-- Step 1: Service -->
      <div data-step-panel="1">
        <h2 class="text-base font-semibold text-dark">Choose a service</h2>
        <p class="mt-1 text-sm text-muted">Select the review you'd like to book.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2" id="service-options">
          <% services.forEach(function (service) { %>
          <button
            type="button"
            class="service-option flex flex-col items-start rounded-xl border border-line p-4 text-left transition-colors hover:border-primary/50"
            data-service-id="<%= service.id %>"
            data-service-slug="<%= service.slug %>"
            data-service-name="<%= service.name %>"
            data-service-duration="<%= service.durationMinutes %>"
          >
            <span class="text-sm font-medium text-dark"><%= service.name %></span>
            <% if (service.shortDescription) { %><span class="mt-1 text-xs text-muted"><%= service.shortDescription %></span><% } %>
          </button>
          <% }) %>
        </div>
        <% if (services.length === 0) { %>
        <p class="text-sm text-muted">No services are configured yet. Please call the clinic to book.</p>
        <% } %>
      </div>

      <!-- Step 2: Date (+ doctor if more than one) -->
      <div data-step-panel="2" class="hidden">
        <h2 class="text-base font-semibold text-dark">Choose a date</h2>
        <p class="mt-1 text-sm text-muted">Open Monday–Saturday, <%= clinic.weekdayOpen %>–<%= clinic.weekdayClose %>. Closed Sundays.</p>
        <div id="doctor-picker" class="mt-5 hidden">
          <label class="text-sm font-medium text-ink" for="doctor-select">Doctor</label>
          <select id="doctor-select" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm">
            <% doctors.forEach(function (doctor) { %>
            <option value="<%= doctor.id %>"><%= doctor.name %><% if (doctor.specialization) { %> — <%= doctor.specialization %><% } %></option>
            <% }) %>
          </select>
        </div>
        <div class="mt-5">
          <label class="text-sm font-medium text-ink" for="date-input">Date</label>
          <input type="date" id="date-input" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
          <p id="date-error" class="mt-1.5 hidden text-sm text-red-600"></p>
        </div>
        <div class="mt-6 flex justify-between">
          <button type="button" class="btn-secondary" data-back="1">Back</button>
          <button type="button" class="btn-primary" id="to-step-3">Continue</button>
        </div>
      </div>

      <!-- Step 3: Time -->
      <div data-step-panel="3" class="hidden">
        <h2 class="text-base font-semibold text-dark">Choose a time</h2>
        <p class="mt-1 text-sm text-muted" id="time-subtitle"></p>
        <div class="mt-5 grid grid-cols-3 gap-2 sm:grid-cols-4" id="time-slots"></div>
        <p id="time-empty" class="hidden text-sm text-muted">No slots available on this date. Please choose another date.</p>
        <p id="time-loading" class="text-sm text-muted">Loading available times…</p>
        <div class="mt-6 flex justify-between">
          <button type="button" class="btn-secondary" data-back="2">Back</button>
          <button type="button" class="btn-primary" id="to-step-4" disabled>Continue</button>
        </div>
      </div>

      <!-- Step 4: Patient info -->
      <div data-step-panel="4" class="hidden">
        <h2 class="text-base font-semibold text-dark">Your information</h2>
        <p class="mt-1 text-sm text-muted">We'll use this to confirm your appointment.</p>
        <form id="patient-form" class="mt-5 space-y-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="text-sm font-medium text-ink" for="firstName">Full name<span class="text-red-600">*</span></label>
              <input required id="firstName" name="firstName" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-ink" for="phone">Phone number<span class="text-red-600">*</span></label>
              <input required id="phone" name="phone" type="tel" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-ink" for="email">Email</label>
              <input id="email" name="email" type="email" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-ink" for="age">Age</label>
              <input id="age" name="age" type="number" min="0" max="120" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-ink" for="gender">Gender</label>
              <select id="gender" name="gender" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm">
                <option value="">Prefer not to say</option>
                <option value="MALE">Male</option>
                <option value="FEMALE">Female</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
          </div>
          <div>
            <label class="text-sm font-medium text-ink" for="reason">Reason for visit</label>
            <textarea id="reason" name="reason" rows="3" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" placeholder="Optional notes for the doctor"></textarea>
          </div>
          <p id="form-error" class="hidden text-sm text-red-600"></p>
          <div class="flex justify-between">
            <button type="button" class="btn-secondary" data-back="3">Back</button>
            <button type="submit" class="btn-primary" id="submit-booking">Confirm Appointment</button>
          </div>
        </form>
      </div>

      <!-- Step 5: Confirmation -->
      <div data-step-panel="5" class="hidden text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-2xl text-primary">✓</span>
        <h2 class="mt-4 text-xl font-semibold text-dark">Appointment Confirmed</h2>
        <dl class="mx-auto mt-6 max-w-sm space-y-2 rounded-xl border border-line bg-background p-5 text-left text-sm">
          <div class="flex justify-between"><dt class="text-muted">Appointment ID</dt><dd class="font-medium text-dark" id="confirm-code"></dd></div>
          <div class="flex justify-between"><dt class="text-muted">Service</dt><dd class="font-medium text-dark" id="confirm-service"></dd></div>
          <div class="flex justify-between"><dt class="text-muted">Date</dt><dd class="font-medium text-dark" id="confirm-date"></dd></div>
          <div class="flex justify-between"><dt class="text-muted">Time</dt><dd class="font-medium text-dark" id="confirm-time"></dd></div>
          <div class="flex justify-between"><dt class="text-muted">Clinic</dt><dd class="font-medium text-dark">Zafoor Clinic</dd></div>
        </dl>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="#" id="add-to-calendar" class="btn-secondary">Add to Calendar</a>
          <a href="tel:<%= clinic.phone %>" class="btn-secondary">Call Clinic</a>
          <a href="/location" class="btn-secondary">Get Directions</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
<script src="/js/booking.js" defer></script>
