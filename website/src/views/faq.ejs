<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 lg:px-8">
      <p class="section-label">FAQ</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-dark sm:text-4xl">Frequently asked questions</h1>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <% if (faqs.length === 0) { %>
    <p class="text-center text-sm text-muted">No FAQs published yet. Please call the clinic with any questions.</p>
    <% } else { %>
    <div class="divide-y divide-line">
      <% faqs.forEach(function (faq) { %>
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium text-ink">
          <%= faq.question %>
          <span class="ml-4 text-muted transition-transform group-open:rotate-45">＋</span>
        </summary>
        <p class="mt-2 text-sm leading-relaxed text-muted"><%= faq.answer %></p>
      </details>
      <% }) %>
    </div>
    <% } %>

    <div class="mt-10 rounded-2xl border border-line bg-surface p-6 text-center">
      <p class="text-sm text-muted">Still have a question?</p>
      <a href="/contact" class="mt-2 inline-block text-sm font-medium text-primary hover:underline">Contact the clinic →</a>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
