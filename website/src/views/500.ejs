<%- include('partials/head', { title: 'Something went wrong — Zafoor Clinic', description: '' }) %>
<% if (clinic) { %><%- include('partials/nav', { clinic }) %><% } %>

<main id="main">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-red-100 text-2xl">⚠️</span>
    <h1 class="mt-6 text-2xl font-semibold text-dark">Something went wrong</h1>
    <p class="mt-2 text-sm text-muted">Please try again in a moment, or call the clinic directly if this keeps happening.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back to Home</a>
      <% if (clinic) { %><a href="tel:<%= clinic.phone %>" class="btn-secondary">Call <%= clinic.phone %></a><% } %>
    </div>
  </section>
</main>

<% if (clinic) { %><%- include('partials/footer', { clinic }) %><% } else { %></body></html><% } %>
