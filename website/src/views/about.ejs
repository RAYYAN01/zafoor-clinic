<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <p class="section-label">About Us</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-dark sm:text-4xl">About Zafoor Clinic</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted">
        Zafoor Clinic is a neighbourhood clinic in George Town, Chennai, offering evening consultations for
        everyday health concerns — hair and skin, thyroid and diabetes reviews, and general health check-ins.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <p class="section-label">What we offer</p>
        <h2 class="mt-2 text-xl font-semibold text-dark">Focused, practical consultations</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Our reviews are built around the concerns patients bring to us most often — hairfall, acne, thyroid,
          skin, diabetes and general health. Each visit is a focused consultation, so you leave with a clear
          plan rather than a long wait.
        </p>
      </div>
      <div>
        <p class="section-label">When we're open</p>
        <h2 class="mt-2 text-xl font-semibold text-dark">Evening hours that fit your day</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          We see patients Monday to Saturday, <%= clinic.weekdayOpen %> – <%= clinic.weekdayClose %>, so you can
          visit after work or school. We are closed on Sundays.
        </p>
      </div>
    </div>

    <div class="mt-12 rounded-2xl border border-line bg-surface p-8 text-center">
      <h2 class="text-xl font-semibold text-dark">Visit us</h2>
      <p class="mt-2 text-sm text-muted"><%= clinic.addressLine %><% if (clinic.landmark) { %> — <%= clinic.landmark %><% } %></p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="/book" class="btn-primary">Book an Appointment</a>
        <a href="/location" class="btn-secondary">Get Directions</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
