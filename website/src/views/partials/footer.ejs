<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2">
          <img src="/logo/zafoor-logo.jpeg" alt="Zafoor Clinic" class="h-8 w-auto" />
        </a>
        <p class="mt-3 text-sm text-muted"><%= clinic.addressLine %></p>
        <% if (clinic.landmark) { %><p class="text-sm text-muted"><%= clinic.landmark %></p><% } %>
      </div>

      <div>
        <p class="section-label">Contact</p>
        <ul class="mt-3 space-y-2 text-sm text-ink/80">
          <li><a class="hover:text-primary" href="tel:<%= clinic.phone %>"><%= clinic.phone %></a></li>
          <li><a class="hover:text-primary" href="mailto:<%= clinic.email %>"><%= clinic.email %></a></li>
        </ul>
      </div>

      <div>
        <p class="section-label">Hours</p>
        <ul class="mt-3 space-y-1 text-sm text-ink/80">
          <li>Mon – Sat: <%= clinic.weekdayOpen %> – <%= clinic.weekdayClose %></li>
          <li>Sunday: <%= clinic.sundayClosed ? "Closed" : "Open" %></li>
        </ul>
      </div>

      <div>
        <p class="section-label">Quick Links</p>
        <ul class="mt-3 space-y-2 text-sm text-ink/80">
          <li><a class="hover:text-primary" href="/services">Services</a></li>
          <li><a class="hover:text-primary" href="/book">Book Appointment</a></li>
          <li><a class="hover:text-primary" href="/faq">FAQ</a></li>
          <li><a class="hover:text-primary" href="/privacy">Privacy Policy</a></li>
          <li><a class="hover:text-primary" href="/terms">Terms &amp; Conditions</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-2 border-t border-line pt-6 text-xs text-muted sm:flex-row">
      <p>&copy; <%= new Date().getFullYear() %> Zafoor Clinic. All rights reserved.</p>
      <p>George Town, Chennai, Tamil Nadu</p>
    </div>
  </div>
</footer>

<script src="/js/main.js" defer></script>
</body>
</html>
