<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-line/70 bg-background/80 backdrop-blur-xs transition-shadow"
  data-scroll-nav
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/logo/zafoor-logo.jpeg" alt="Zafoor Clinic" class="h-8 w-auto sm:h-9" />
    </a>

    <ul class="hidden items-center gap-7 text-sm font-medium text-ink/80 lg:flex">
      <li><a class="hover:text-primary" href="/">Home</a></li>
      <li><a class="hover:text-primary" href="/about">About</a></li>
      <li><a class="hover:text-primary" href="/services">Services</a></li>
      <li><a class="hover:text-primary" href="/doctors">Doctors</a></li>
      <li><a class="hover:text-primary" href="/reviews">Reviews</a></li>
      <li><a class="hover:text-primary" href="/contact">Contact</a></li>
    </ul>

    <div class="hidden items-center gap-3 lg:flex">
      <a href="tel:<%= clinic.phone %>" class="text-sm font-medium text-ink/80 hover:text-primary">
        Call <%= clinic.phone %>
      </a>
      <a href="/book" class="btn-primary">Book Appointment</a>
    </div>

    <button
      type="button"
      id="mobile-menu-button"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-line text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface lg:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3 text-sm font-medium text-ink/80">
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/">Home</a></li>
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/about">About</a></li>
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/services">Services</a></li>
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/doctors">Doctors</a></li>
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/reviews">Reviews</a></li>
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/contact">Contact</a></li>
      <li><a class="block rounded-lg px-3 py-2 hover:bg-background hover:text-primary" href="/faq">FAQ</a></li>
      <li class="pt-2">
        <a href="/book" class="btn-primary w-full">Book Appointment</a>
      </li>
      <li>
        <a href="tel:<%= clinic.phone %>" class="btn-secondary w-full">Call <%= clinic.phone %></a>
      </li>
    </ul>
  </div>
</header>
