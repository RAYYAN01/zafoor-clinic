<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:px-8">
      <p class="section-label">Doctors & Specialists</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-dark sm:text-4xl">Who you'll see</h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
    <% if (doctors.length === 0) { %>
    <p class="text-center text-sm text-muted">Doctor profiles will be listed here shortly.</p>
    <% } else { %>
    <div class="grid gap-5 sm:grid-cols-2">
      <% doctors.forEach(function (doctor) { %>
      <div class="card flex items-start gap-4 p-6">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-accent/50 text-lg font-semibold text-primary">
          <%= doctor.name.replace('Dr.', '').trim().charAt(0) %>
        </span>
        <div>
          <h2 class="text-base font-semibold text-dark"><%= doctor.name %></h2>
          <% if (doctor.specialization) { %><p class="mt-1 text-sm text-muted"><%= doctor.specialization %></p><% } %>
          <a href="/book" class="mt-3 inline-block text-sm font-medium text-primary hover:underline">Book an appointment →</a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-2xl px-4 py-14 text-center sm:px-6 lg:px-8">
      <img
        src="/images/clinic/image3.png"
        alt="Dr. Mufeeda Roohi — Aesthetic Physician, Diabetologist, Family Physician"
        class="mx-auto aspect-[3/2] w-full rounded-2xl object-cover shadow-soft"
      />
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
