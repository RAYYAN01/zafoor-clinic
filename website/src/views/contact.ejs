<%- include('partials/head', { title, description }) %>
<%- include('partials/nav', { clinic }) %>

<main id="main">
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:px-8">
      <p class="section-label">Contact</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-dark sm:text-4xl">Get in touch</h1>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold text-dark">Zafoor Clinic</h2>
        <p class="mt-2 text-sm text-muted"><%= clinic.addressLine %></p>
        <% if (clinic.landmark) { %><p class="text-sm text-muted"><%= clinic.landmark %></p><% } %>

        <dl class="mt-6 space-y-3 text-sm">
          <div class="flex items-center gap-3"><dt class="w-20 text-muted">Phone</dt><dd><a class="font-medium text-primary hover:underline" href="tel:<%= clinic.phone %>"><%= clinic.phone %></a></dd></div>
          <div class="flex items-center gap-3"><dt class="w-20 text-muted">Email</dt><dd><a class="font-medium text-primary hover:underline" href="mailto:<%= clinic.email %>"><%= clinic.email %></a></dd></div>
          <div class="flex items-center gap-3"><dt class="w-20 text-muted">Hours</dt><dd class="font-medium text-ink">Mon–Sat <%= clinic.weekdayOpen %>–<%= clinic.weekdayClose %>, Sun closed</dd></div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="tel:<%= clinic.phone %>" class="btn-primary">Call Now</a>
          <a href="mailto:<%= clinic.email %>" class="btn-secondary">Email Us</a>
          <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(clinic.mapQuery || clinic.addressLine) %>" class="btn-secondary" target="_blank" rel="noopener">Get Directions</a>
        </div>
      </div>

      <div class="card overflow-hidden">
        <iframe
          title="Zafoor Clinic map"
          class="h-72 w-full sm:h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=<%= encodeURIComponent(clinic.mapQuery || clinic.addressLine) %>&output=embed"
        ></iframe>
      </div>
    </div>

    <div class="mt-14 max-w-xl">
      <h2 class="text-lg font-semibold text-dark">Send us a message</h2>
      <p class="mt-1 text-sm text-muted">For appointments, please use the <a class="text-primary hover:underline" href="/book">booking page</a> — it's faster. Use this for general questions.</p>
      <form class="mt-5 space-y-4" action="mailto:<%= clinic.email %>" method="get" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="text-sm font-medium text-ink" for="cf-name">Name</label>
            <input id="cf-name" name="name" required class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
          </div>
          <div>
            <label class="text-sm font-medium text-ink" for="cf-email">Email</label>
            <input id="cf-email" name="subject" type="email" required class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm" />
          </div>
        </div>
        <div>
          <label class="text-sm font-medium text-ink" for="cf-message">Message</label>
          <textarea id="cf-message" name="body" rows="4" required class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm"></textarea>
        </div>
        <button type="submit" class="btn-primary">Send Message</button>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
