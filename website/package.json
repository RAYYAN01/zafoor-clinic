{
  "name": "zafoor-clinic-website",
  "version": "1.0.0",
  "private": true,
  "description": "Zafoor Clinic public website — Node.js/Express, server-rendered HTML5, Tailwind CSS.",
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:dev:server\"",
    "dev:server": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/styles.css --watch",
    "build": "npm run build:css",
    "start": "node src/server.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "tailwindcss": "^3.4.13"
  }
}
